# Get it from https://www.agent37.com/dashboard/cloud/api-keys
AGENT37_API_KEY=sk_live_replace_me

# Your OpenRouter key — https://openrouter.ai/settings/keys
# Every agent's model calls are billed to this key, through this app's /api/llm proxy. It is
# server-only: it never reaches the browser and never reaches an agent instance.
OPENROUTER_API_KEY=sk-or-replace_me

# Get it from https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_replace_me

# Filled in by `npm run setup` — leave blank for a fresh free project, or paste an
# existing project's values (Project Settings -> API) to use that one instead.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Also filled in by `npm run setup`. Server-only (no NEXT_PUBLIC_ prefix) — never commit it
# or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# The URL agents call for every model turn, so it MUST be reachable from the internet.
# In production: your deployed URL. Locally: `npm run tunnel` writes one here for you.
# NEXT_PUBLIC_SITE_URL=https://your-app.com
